{
  "name": "2048-bot",
  "version": "1.0.0",
  "description": "An automated bot designed to play the web version of [2048](https://play2048.co/) dynamically using [Playwright](https://playwright.dev/)—no AI, external solvers, or human intervention required.",
  "scripts": {
    "play": "BOT_PLAY=true playwright test tests/bot-2048.spec.ts --headed",
    "start": "npm run play",
    "test": "playwright test",
    "test:headed": "playwright test --headed",
    "test:headless": "playwright test",
    "typecheck": "tsc --noEmit"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/davidschraedel/2048-bot.git"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "bugs": {
    "url": "https://github.com/davidschraedel/2048-bot/issues"
  },
  "homepage": "https://github.com/davidschraedel/2048-bot#readme",
  "devDependencies": {
    "@playwright/test": "^1.65.0",
    "@types/node": "^26.6.6",
    "typescript": "^7.0.2"
  },
  "dependencies": {
    "dotenv": "^18.0.10"
  }
}
